{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataForge Workbench",
  "version": "0.1.0",
  "identifier": "io.dataforge.workbench",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build" },
  "app": { "windows": [{ "title": "DataForge Workbench", "width": 1440, "height": 960, "minWidth": 1120, "minHeight": 720, "resizable": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
