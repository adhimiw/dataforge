# DataForge reads the Zen credential through the upstream-compatible variable below.
# Never commit a real key. Create a local .env or export it in your shell.
OPENCODE_API_KEY=

# Keep Big Pickle as the only selectable provider/model by default.
# Set to 1 only when you intentionally want to use other providers.
DATAFORGE_ALLOW_PROVIDER_SWITCH=0

# Optional: use a custom native binary when running a packaged build.
# DATAFORGE_BIN_PATH=
